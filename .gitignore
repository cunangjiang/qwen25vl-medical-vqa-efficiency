# -----------------------------
.env
.env.*
!.env.example
credentials.json
credentials*.json
secrets.json
secrets*.json
*.pem
*.key

# Machine-specific helper files
env.sh
local_config.*
*.local.yaml
*.local.yml
*.local.json

