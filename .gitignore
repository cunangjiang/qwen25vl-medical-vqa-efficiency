# -----------------------------
# Model weights / checkpoints
# -----------------------------
models/
outputs/
checkpoints/
checkpoint-*/
**/checkpoint-*/
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.gguf

# Some model repos still use generic *.bin weight files.
# Keep source/config JSON explicitly rather than committing binary blobs.
pytorch_model*.bin
model*.bin
optimizer*.bin

# -----------------------------
# Dataset / caches / raw media
# -----------------------------
data/
cache/
.cache/
huggingface/
.huggingface/
datasets/
manifests/

# Raw review-image exports / bundles
review_images/
**/review_images/
day*_review_bundle*
*.tar
*.tar.gz
*.tgz
*.zip
*.7z

# -----------------------------
# Raw experiment outputs
# -----------------------------
logs/
runs/
wandb/
.wandb/
screenlog.*
nohup.out

# Full prediction tables stay in the private experiment workspace.
results/**/*predictions*.csv
*_predictions.csv

# Trainer/runtime state that is not part of the public release
trainer_state.json
optimizer.pt
scheduler.pt
rng_state*.pth
training_args.bin

